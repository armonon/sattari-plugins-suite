+void SattariAutoPitchAudioProcessor::applyCorrectionLookahead (juce::AudioBuffer<float>& buffer) noexcept
+{
+    const int size = lookaheadRing.getNumSamples();
+    if (correctionLookaheadSamples <= 0 || size <= correctionLookaheadSamples)
+        return;
+
+    const int n = buffer.getNumSamples();
+    const int numChannels = juce::jmin (buffer.getNumChannels(), lookaheadRing.getNumChannels());
+    for (int ch = 0; ch < numChannels; ++ch)
+    {
+        auto* data = buffer.getWritePointer (ch);
+        auto* line = lookaheadRing.getWritePointer (ch);
+        for (int i = 0; i < n; ++i)
+        {
+            const int w = (lookaheadWrite + i) % size;
+            line[w] = data[i];
+            data[i] = line[(w - correctionLookaheadSamples + size) % size];
+        }
+    }
+    lookaheadWrite = (lookaheadWrite + n) % size;
+}
