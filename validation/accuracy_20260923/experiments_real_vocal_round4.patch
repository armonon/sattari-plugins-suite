+double SattariAutoPitchAudioProcessor::delayedCorrectionScale (double scale, int numSamples)
+{
+    const int size = (int) correctionScaleHistory.size();
+    if (size == 0) return scale;
+    const int lookBack = juce::jmin (correctionDelaySamples, size - 1) - numSamples / 2;
+    const double out = lookBack > 0 ? correctionScaleHistory[(size_t) ((correctionScaleWrite - lookBack + size) % size)] : scale;
+    for (int i = 0; i < juce::jmin (numSamples, size); ++i)
+    {
+        correctionScaleHistory[(size_t) correctionScaleWrite] = scale;
+        correctionScaleWrite = (correctionScaleWrite + 1) % size;
+    }
+    return out;
+}
