# Build products
build/
/build-*/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
compile_commands.json

# Local Python / smoke-test state
.venv/
tmp/
__pycache__/
*/__pycache__/

# IDE / OS
.DS_Store
.vscode/
.idea/

# Generated plugin bundles / installers
*.vst3/
*.component/
*.app/
*.pkg
*.dmg
*.zip
*.tar.gz

# Swift build cache
apps/sattari-hub/.build/

# Third-party deps.
#   JUCE 8.0.12 is tracked as a git submodule (third_party/JUCE) — a clean clone
#   needs `git submodule update --init --recursive` (CI uses submodules: recursive).
#   Rubber Band is vendored as source (third_party/rubberband, ~1.7 MB) so the
#   Rubber Band-dependent plugins build from a clean checkout with no extra fetch.
#   Only the broken-extract scratch dir stays ignored.
third_party/.rubberband_broken/
third_party/ARA_SDK/

# Logs + FUSE filesystem leftovers.
*.log
**/.fuse_hidden*

# Render-harness audio output is regenerable (run AutoPitchRender). The committed
# regression reference is the small text fingerprint in validation/golden/, NOT
# the .wav.
validation/renders/

# Local Netlify folder
.netlify
third_party/onnxruntime-osx-universal2-*/
third_party/onnxruntime-win-x64-*/

# Python caches
__pycache__/
*.pyc

# Hosted download artifacts (deployed, not committed)
apps/sattari-web/downloads/
apps/sattari-web/*.tsbuildinfo
validation/giantsteps/
# Key-detection training corpora (fetched via scripts/, multi-GB, not committed)
validation/gtzan/
validation/combined/
validation/fma/
# Feature caches (regenerated by scripts/, large binary)
validation/*.npz
validation/*.npy
*.onnx
!plugins/auto-pitch/models/crepe.onnx

# Vocal-derived audio never enters git. The corpus manifests point at absolute
# paths outside the repository, and these renders are derived from cleared-for-
# internal-eval material whose public_release_allowed is false. Untracked is not
# enough: one `git add -A` would publish a singer's voice.
validation/auto-pitch/renders/
validation/corpus/**/*.wav
validation/corpus/**/*.m4a
validation/listening/**/*.wav
