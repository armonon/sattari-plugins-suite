+void drawNavGlyph (juce::Graphics& g, juce::Rectangle<int> r, int index, juce::Colour colour)
+{
+    auto f = r.toFloat().reduced (2.0f);
+    g.setColour (colour);
+
+    switch (index)
+    {
+        case 0:
+            g.drawRoundedRectangle (f, 3.0f, 1.2f);
+            g.drawLine (f.getX() + 4.0f, f.getCentreY(), f.getRight() - 4.0f, f.getCentreY(), 1.2f);
+            break;
+        case 1:
+            for (int i = 0; i < 3; ++i)
+            {
+                const float x = f.getX() + 3.0f + (float) i * 5.0f;
+                g.drawLine (x, f.getY(), x, f.getBottom(), 1.1f);
+                g.fillRoundedRectangle (x - 2.0f, f.getY() + 3.0f + (float) (i % 2) * 5.0f, 4.0f, 3.0f, 1.0f);
+            }
+            break;
+        case 2:
+            for (int i = 0; i < 4; ++i)
+                g.fillRoundedRectangle (f.getX(), f.getY() + 2.0f + (float) i * 4.0f,
+                                        f.getWidth() * (0.42f + 0.13f * (float) i), 2.0f, 1.0f);
+            break;
+        case 3:
+            for (int y = 0; y < 2; ++y)
+                for (int x = 0; x < 2; ++x)
+                    g.drawRoundedRectangle (juce::Rectangle<float> (f.getX() + (float) x * 8.0f,
+                                                                     f.getY() + (float) y * 8.0f,
+                                                                     5.0f, 5.0f),
+                                            1.0f, 1.1f);
+            break;
+        case 4:
+        {
+            juce::Path p;
+            p.startNewSubPath (f.getX(), f.getCentreY());
+            p.cubicTo (f.getX() + 5.0f, f.getY(), f.getRight() - 5.0f, f.getBottom(), f.getRight(), f.getCentreY());
+            g.strokePath (p, juce::PathStrokeType (1.2f));
+            g.fillEllipse (f.withSizeKeepingCentre (4.0f, 4.0f));
+            break;
+        }
+        case 5:
+            g.drawRoundedRectangle (f.withSizeKeepingCentre (8.0f, 12.0f), 4.0f, 1.2f);
+            g.drawLine (f.getCentreX(), f.getBottom() - 3.0f, f.getCentreX(), f.getBottom() + 2.0f, 1.2f);
+            break;
+        case 6:
+            g.fillEllipse (f.withSizeKeepingCentre (8.0f, 8.0f));
+            g.drawEllipse (f.withSizeKeepingCentre (14.0f, 14.0f), 1.0f);
+            break;
+        case 7:
+            g.drawRoundedRectangle (f, 2.0f, 1.2f);
+            g.drawLine (f.getX() + 4.0f, f.getY() + 5.0f, f.getRight() - 3.0f, f.getY() + 5.0f, 1.1f);
+            break;
+        default:
+            g.drawEllipse (f, 1.2f);
+            g.fillEllipse (f.withSizeKeepingCentre (4.0f, 4.0f));
+            break;
+    }
+}
