+void StemDeckLookAndFeel::drawLinearSlider (juce::Graphics& g, int x, int y, int width, int height,
+                                            float sliderPos, float minSliderPos, float maxSliderPos,
+                                            juce::Slider::SliderStyle style, juce::Slider& slider)
+{
+    juce::ignoreUnused (minSliderPos, maxSliderPos);
+    const auto accent = slider.findColour (juce::Slider::trackColourId, true);
+    const auto rail = juce::Colour (0xff1a2831);
+
+    if (style == juce::Slider::LinearVertical)
+    {
+        auto r = juce::Rectangle<float> ((float) x + (float) width * 0.5f - 5.0f,
+                                         (float) y + 6.0f,
+                                         10.0f,
+                                         (float) height - 12.0f);
+        g.setColour (juce::Colour (0xff05090d));
+        g.fillRoundedRectangle (r.expanded (3.0f, 0.0f), 3.0f);
+        g.setColour (rail);
+        g.fillRoundedRectangle (r, 2.0f);
+
+        const float pos = juce::jlimit (r.getY(), r.getBottom(), sliderPos);
+        auto active = juce::Rectangle<float> (r.getX(), pos, r.getWidth(), r.getBottom() - pos);
+        g.setGradientFill (juce::ColourGradient (accent, active.getTopLeft(),
+                                                 juce::Colour (0xff37d88f), active.getBottomLeft(), false));
+        g.fillRoundedRectangle (active, 2.0f);
+        g.setColour (juce::Colours::white.withAlpha (0.76f));
+        g.fillRoundedRectangle (juce::Rectangle<float> ((float) x + 8.0f, pos - 4.0f,
+                                                        (float) width - 16.0f, 8.0f), 2.0f);
+        return;
+    }
+
+    auto r = juce::Rectangle<float> ((float) x + 6.0f,
+                                     (float) y + (float) height * 0.5f - 2.0f,
+                                     (float) width - 12.0f,
+                                     4.0f);
+    g.setColour (rail);
+    g.fillRoundedRectangle (r, 2.0f);
+
+    const float pos = juce::jlimit (r.getX(), r.getRight(), sliderPos);
+    auto active = juce::Rectangle<float> (r.getX(), r.getY(), pos - r.getX(), r.getHeight());
+    g.setColour (accent.withAlpha (0.86f));
+    g.fillRoundedRectangle (active, 2.0f);
+    g.setColour (accent.brighter (0.18f));
+    g.fillEllipse (pos - 4.0f, r.getCentreY() - 4.0f, 8.0f, 8.0f);
+}
+
+void StemDeckLookAndFeel::drawRotarySlider (juce::Graphics& g, int x, int y, int width, int height,
+                                            float sliderPosProportional, float rotaryStartAngle,
+                                            float rotaryEndAngle, juce::Slider& slider)
+{
+    const auto accent = slider.findColour (juce::Slider::rotarySliderFillColourId, true);
+    auto bounds = juce::Rectangle<float> ((float) x, (float) y, (float) width, (float) height).reduced (4.0f);
+    const float radius = juce::jmin (bounds.getWidth(), bounds.getHeight()) * 0.5f - 2.0f;
+    const auto centre = bounds.getCentre();
+    const float angle = rotaryStartAngle + sliderPosProportional * (rotaryEndAngle - rotaryStartAngle);
+
+    g.setGradientFill (juce::ColourGradient (juce::Colour (0xff1a2630), centre.x, bounds.getY(),
+                                             juce::Colour (0xff070c11), centre.x, bounds.getBottom(), false));
+    g.fillEllipse (juce::Rectangle<float> (radius * 2.0f, radius * 2.0f).withCentre (centre));
+    g.setColour (juce::Colour (0xff30414b));
+    g.drawEllipse (juce::Rectangle<float> (radius * 2.0f, radius * 2.0f).withCentre (centre), 1.0f);
+
+    juce::Path track;
+    track.addCentredArc (centre.x, centre.y, radius + 2.0f, radius + 2.0f, 0.0f,
+                         rotaryStartAngle, rotaryEndAngle, true);
+    g.setColour (juce::Colour (0xff1c2c35));
+    g.strokePath (track, juce::PathStrokeType (2.2f, juce::PathStrokeType::curved, juce::PathStrokeType::rounded));
+
+    juce::Path arc;
+    arc.addCentredArc (centre.x, centre.y, radius + 2.0f, radius + 2.0f, 0.0f,
+                       rotaryStartAngle, angle, true);
+    g.setColour (accent.withAlpha (0.90f));
+    g.strokePath (arc, juce::PathStrokeType (2.2f, juce::PathStrokeType::curved, juce::PathStrokeType::rounded));
+
+    const auto tip = juce::Point<float> (centre.x + radius * 0.64f * std::cos (angle - juce::MathConstants<float>::halfPi),
+                                         centre.y + radius * 0.64f * std::sin (angle - juce::MathConstants<float>::halfPi));
+    g.setColour (juce::Colours::white.withAlpha (0.72f));
+    g.drawLine ({ centre, tip }, 2.0f);
 }
 
