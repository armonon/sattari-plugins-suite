+void StemDeckLookAndFeel::drawButtonBackground (juce::Graphics& g, juce::Button& b,
+                                                const juce::Colour& backgroundColour,
+                                                bool shouldDrawButtonAsHighlighted,
+                                                bool shouldDrawButtonAsDown)
+{
+    const auto text = b.getButtonText();
+    const bool on = b.getToggleState() || shouldDrawButtonAsDown;
+    const bool transport = text.equalsIgnoreCase ("PLAY") || text.containsIgnoreCase ("REC");
+    const auto accent = b.findColour (juce::TextButton::buttonOnColourId, true);
+    auto fill = backgroundColour.getAlpha() == 0 ? juce::Colour (0xff111c25) : backgroundColour;
+    if (transport)
+        fill = accent.withAlpha (on ? 0.32f : 0.14f);
+    else if (on)
+        fill = accent.withAlpha (0.24f);
+    else if (shouldDrawButtonAsHighlighted)
+        fill = fill.brighter (0.12f);
+
+    auto r = b.getLocalBounds().toFloat().reduced (0.5f);
+    g.setGradientFill (juce::ColourGradient (fill.brighter (0.08f), r.getTopLeft(),
+                                             fill.darker (0.22f), r.getBottomLeft(), false));
+    g.fillRoundedRectangle (r, 4.0f);
+    g.setColour ((on || shouldDrawButtonAsHighlighted) ? accent.withAlpha (0.58f)
+                                                       : juce::Colour (0xff263741));
+    g.drawRoundedRectangle (r, 4.0f, 1.0f);
+
+    if (transport)
+    {
+        g.setColour (accent.withAlpha (on ? 0.34f : 0.16f));
+        g.drawRoundedRectangle (r.reduced (2.0f), 3.0f, 1.0f);
+    }
+}
+
+void StemDeckLookAndFeel::drawButtonText (juce::Graphics& g, juce::TextButton& b,
+                                          bool shouldDrawButtonAsHighlighted,
+                                          bool shouldDrawButtonAsDown)
+{
+    const auto text = b.getButtonText();
+    auto area = b.getLocalBounds().reduced (4, 1);
+    const auto accent = b.findColour (juce::TextButton::buttonOnColourId, true);
+
+    if (text.equalsIgnoreCase ("PLAY"))
+    {
+        juce::Path play;
+        const float s = (float) juce::jmin (area.getWidth(), area.getHeight()) * 0.42f;
+        const auto c = area.toFloat().getCentre();
+        play.startNewSubPath (c.x - s * 0.36f, c.y - s * 0.55f);
+        play.lineTo (c.x - s * 0.36f, c.y + s * 0.55f);
+        play.lineTo (c.x + s * 0.58f, c.y);
+        play.closeSubPath();
+        g.setColour (accent.brighter (shouldDrawButtonAsDown ? 0.0f : 0.2f));
+        g.fillPath (play);
+        return;
+    }
+
+    if (text.containsIgnoreCase ("REC") || text.containsIgnoreCase ("Record"))
+    {
+        g.setColour (juce::Colour (0xffff6a75));
+        g.fillEllipse ((float) area.getX() + 10.0f, (float) area.getCentreY() - 3.5f, 7.0f, 7.0f);
+        area.removeFromLeft (22);
+    }
+
+    g.setFont (getTextButtonFont (b, b.getHeight()));
+    g.setColour ((shouldDrawButtonAsHighlighted || shouldDrawButtonAsDown || b.getToggleState())
+                     ? juce::Colours::white
+                     : b.findColour (juce::TextButton::textColourOffId, true));
+    g.drawText (text, area, juce::Justification::centred, true);
+}
+
+void StemDeckLookAndFeel::drawToggleButton (juce::Graphics& g, juce::ToggleButton& b,
+                                            bool shouldDrawButtonAsHighlighted,
+                                            bool shouldDrawButtonAsDown)
+{
+    const bool on = b.getToggleState();
+    const auto accent = b.findColour (juce::ToggleButton::tickColourId, true);
+    auto r = b.getLocalBounds().toFloat().reduced (0.5f);
+    auto fill = on ? accent.withAlpha (0.24f) : juce::Colour (0xff111b23);
+    if (shouldDrawButtonAsHighlighted)
+        fill = fill.brighter (0.12f);
+
+    g.setGradientFill (juce::ColourGradient (fill.brighter (0.08f), r.getTopLeft(),
+                                             fill.darker (0.20f), r.getBottomLeft(), false));
+    g.fillRoundedRectangle (r, 4.0f);
+    g.setColour (on ? accent.withAlpha (0.72f) : juce::Colour (0xff263741));
+    g.drawRoundedRectangle (r, 4.0f, 1.0f);
+
+    if (on)
+    {
+        g.setColour (accent.withAlpha (0.78f));
+        g.fillEllipse (r.getX() + 7.0f, r.getCentreY() - 3.0f, 6.0f, 6.0f);
+    }
+
+    g.setColour (on ? juce::Colours::white.withAlpha (0.92f) : juce::Colours::white.withAlpha (0.72f));
+    g.setFont (juce::FontOptions (juce::jlimit (9.0f, 11.0f, (float) b.getHeight() * 0.34f), juce::Font::bold));
+    auto textArea = b.getLocalBounds().reduced (5, 1);
+    if (on)
+        textArea = textArea.withTrimmedLeft (12);
+    g.drawText (b.getButtonText(), textArea, juce::Justification::centred, true);
+    juce::ignoreUnused (shouldDrawButtonAsDown);
+}
