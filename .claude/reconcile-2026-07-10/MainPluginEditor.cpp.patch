+void drawEffectCard (juce::Graphics& g, juce::Rectangle<int> r, juce::Colour accent, const juce::String& title)
+{
+    g.setColour (juce::Colour (0xff0d171f));
+    g.fillRoundedRectangle (r.toFloat(), 5.0f);
+    g.setColour (accent.withAlpha (0.28f));
+    g.drawRoundedRectangle (r.toFloat().reduced (0.5f), 5.0f, 1.0f);
+    auto header = r.reduced (12, 8).removeFromTop (18);
+    g.setColour (accent);
+    g.fillEllipse ((float) header.getX(), (float) header.getCentreY() - 5.0f, 10.0f, 10.0f);
+    g.setColour (juce::Colours::white.withAlpha (0.78f));
+    g.setFont (juce::FontOptions (11.0f, juce::Font::bold));
+    g.drawText (title, header.withTrimmedLeft (20), juce::Justification::centredLeft);
+    g.setColour (juce::Colours::white.withAlpha (0.32f));
+    g.drawText ("x", header, juce::Justification::centredRight);
+
+    juce::StringArray labels;
+    if (title == "FILTER")
+        labels = { "LPF 12dB", "RES 24%", "DRIVE 12%" };
+    else if (title == "DELAY")
+        labels = { "1/4", "FDBK 36%", "MIX 28%" };
+    else if (title == "REVERB")
+        labels = { "PLATE", "SIZE 52%", "MIX 31%" };
+    else
+        labels = { "LOW", "MID", "HIGH" };
+
+    auto labelArea = r.reduced (36, 28).removeFromTop (16);
+    for (int i = 0; i < labels.size(); ++i)
+    {
+        auto cell = labelArea.removeFromLeft (juce::jmax (1, labelArea.getWidth() / (labels.size() - i)));
+        g.setColour (juce::Colours::white.withAlpha (0.48f));
+        g.setFont (juce::FontOptions (8.5f, juce::Font::bold));
+        g.drawText (labels[i], cell, juce::Justification::centredLeft, true);
+    }
+
+    auto bands = r.reduced (36, 34);
+    for (int i = 0; i < 3; ++i)
+    {
+        auto band = bands.removeFromLeft (juce::jmax (1, bands.getWidth() / (3 - i))).reduced (8, 8);
+        g.setColour (juce::Colours::white.withAlpha (0.08f));
+        g.fillRoundedRectangle (band.withHeight (3).toFloat(), 2.0f);
+        g.setColour (accent.withAlpha (0.82f));
+        g.fillRoundedRectangle (band.withWidth (juce::jmax (12, band.getWidth() * (i + 2) / 4)).withHeight (3).toFloat(), 2.0f);
+    }
+}
